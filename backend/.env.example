# Example .env for backend
# MongoDB connection string (use Atlas or local)
MONGO_URI=mongodb://localhost:27017/sri-vrindas
# Port to run the backend (optional)
PORT=3000
# Optional: admin / restaurant WhatsApp number to receive new order notifications
# Format should be the Twilio WhatsApp format e.g. whatsapp:+9199xxxxxxxx
ADMIN_WHATSAPP=whatsapp:+9199xxxxxxxx
